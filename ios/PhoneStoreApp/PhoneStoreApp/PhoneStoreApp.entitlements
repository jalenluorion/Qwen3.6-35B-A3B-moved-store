<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Device builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]): raises the app's jetsam limit where the device allows.
	     Zero accuracy cost; measured with -memLimitTest (README "Memory limit"). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
